# ── Coquire server ───────────────────────────────────────────────────────────
PORT=3000
APP_ORIGIN=http://localhost:8080          # public origin (Railway: https://<RAILWAY_PUBLIC_DOMAIN>)
DATABASE_PATH=./data/coquire.sqlite       # Railway: ${RAILWAY_VOLUME_MOUNT_PATH}/coquire.sqlite
SESSION_SECRET=                           # 32 random bytes hex; generated and stored in the DB if empty (dev only)
GUARD_PRIVATE_KEY=                        # the guard co-signer; generated if empty (dev only)
SUPPLIER_PRIVATE_KEY=                     # built-in OCR supplier payout + sealing key; generated if empty (dev only)
SUPPLIER_NAME=Coquire OCR
SUPPLIER_LIST_RATE=0.06
SUPPLIER_AUTOQUOTE=true
OCR_LANG=eng
TESSDATA_PATH=./data/tessdata

# ── x402 on Hedera testnet (leave empty for simulated settlement) ────────────
X402_NETWORK=hedera:testnet
X402_FACILITATOR_URL=                     # e.g. https://x402.org/facilitator or https://api.testnet.blocky402.com
SUPPLIER_HEDERA_ACCOUNT_ID=
# testnet convenience: the supplier account creates and funds each team's agent account
TESTNET_FUND_FROM_SUPPLIER=true
AGENT_FUND_USDC=7
AGENT_INITIAL_HBAR=0.2               # 0.0.x, associated with USDC 0.0.429274

# ── Arkiv (Rabdi testnet) ────────────────────────────────────────────────────
ARKIV_ACCESS_KEY=                         # https://hub.arkiv.network/access-keys
ARKIV_PRIVATE_KEY=                        # EVM key funded with tGLM from https://hub.arkiv.network/faucet

# ── Chainlink CCIP, Ethereum Sepolia → Hedera testnet ────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
TREASURY_PRIVATE_KEY=                     # Sepolia account with ETH + LINK
HEDERA_DEPLOYER_PRIVATE_KEY=
CCIP_SENDER_ADDRESS=                      # ApprovalSender on Sepolia (contracts/ccip)
CCIP_RECEIVER_ADDRESS=                    # ApprovalReceiver on Hedera testnet (contracts/ccip)

# ── Client ───────────────────────────────────────────────────────────────────
VITE_HEDERA_RPC_URL=https://testnet.hashio.io/api
